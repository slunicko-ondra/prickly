<Window x:Class="PricklyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PricklyApp"
        xmlns:viewModels="clr-namespace:PricklyApp.ViewModels"
        xmlns:models="clr-namespace:PricklyApp.Models"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Closing="MainWindow_OnClosing"
        Title="Prickly" Height="225" Width="450">
    <Window.DataContext>
        <viewModels:MainWindowViewModel></viewModels:MainWindowViewModel>
    </Window.DataContext>
    <Grid Margin="25, 0, 25, 25">
        <!-- Project and Task selection -->
        <Grid Height="120" Width="150" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            
            <Label Grid.Row="0" Content="Project" />
            <ComboBox
                x:Name="ProjectComboBox"
                Grid.Row="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Height="25"
                Width="120"
                ItemsSource="{Binding ProjectNames}"
                SelectionChanged="ProjectComboBox_OnSelected"
                />
            <Button
                x:Name="AddProjectButton"
                Grid.Row="1"
                Height="25"
                Width="25"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="+"
                Click="AddProjectButton_OnClick"/>
            
            <Label Grid.Row="2" Content="Task" />
            <ComboBox
                x:Name="TaskComboBox"
                Grid.Row="3"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Height="25"
                Width="120"
                ItemsSource="{Binding TaskNames}"
                SelectionChanged="TaskComboBox_OnSelectionChanged"/>
            <Button
                x:Name="AddTaskButton"
                Grid.Row="3"
                Height="25"
                Width="25"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="+"
                Click="AddTaskButton_OnClick"/>
        </Grid>
        
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="200" Margin="0, 40, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
                <ColumnDefinition Width="25"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <TextBlock
                x:Name="DotIndicatorTextBlock"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="Red"
                FontSize="14"
                Text="⚫"/>
            <TextBlock
                x:Name="DisplayTimeTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="36"
                Text="{Binding DisplayTime.TimeString}"/>
            <Button Grid.Column="2" Height="25" Width="25" VerticalAlignment="Center">✎</Button>
        </Grid>
        
        <Grid VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="40"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Button
                x:Name="SettingsButton"
                Grid.Column="0"
                Height="25"
                Width="25"
                HorizontalAlignment="Left"
                FontSize="16"
                Padding="0,-3,-1,0"
                Content="⚙️"
                Click="SettingsButton_OnClick"/>
            <Button Grid.Column="1" Name="AboutButton" Height="25" Width="25" HorizontalAlignment="Left" FontSize="22"
                    Padding="0,-5,0,0" Content="ⓘ"/>
            <Button Grid.Column="2" Name="StartStopButton" Height="25" Width="100" HorizontalAlignment="Right"
                    Content="Start" Click="StartStopButton_OnClick"/>
        </Grid>
    </Grid>
</Window>
