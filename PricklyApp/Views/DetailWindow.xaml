<Window x:Class="PricklyApp.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PricklyApp.Views"
        xmlns:viewModels="clr-namespace:PricklyApp.ViewModels"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Detail" Height="350" Width="700">
    <Window.DataContext>
        <viewModels:DetailViewModel/>
    </Window.DataContext>
    <Grid Margin="25, 5, 25, 25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="22"
            Text="{Binding ProjectName, StringFormat={}Project: {0}}"/>
        <TextBlock
            Grid.Row="0"
            Grid.Column="2"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="22"
            Text="{Binding TaskName, StringFormat={}Task: {0}}"/>
        
        <TextBlock 
            Grid.Row="1"
            Grid.Column="0"
            Margin="0, 0, 0, 25"
            FontSize="18"
            Text="Today"/>
        <TextBlock 
            Grid.Row="2"
            Grid.Column="0"
            Margin="0, 0, 0, 25"
            FontSize="18"
            Text="This month"/>
        <TextBlock 
            Grid.Row="3"
            Grid.Column="0"
            Margin="0, 0, 0, 25"
            FontSize="18"
            Text="All time"/>
        
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding ProjectTodayTime}"/>
        <TextBlock
            Grid.Row="1"
            Grid.Column="2"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding TaskTodayTime}"/>
        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding ProjectMonthTime}"/>
        <TextBlock
            Grid.Row="2"
            Grid.Column="2"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding TaskMonthTime}"/>
        <TextBlock
            Grid.Row="3"
            Grid.Column="1"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding ProjectTotalTime}"/>
        <TextBlock
            Grid.Row="3"
            Grid.Column="2"
            Margin="0, 0, 0, 25"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{Binding TaskTotalTime}"/>
        
        <Button 
            Grid.Row="4"
            Grid.Column="1"
            Height="26"
            Width="100"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            IsDefault="True"
            IsCancel="True"
            Content="OK"/>
    </Grid>
</Window>
