<Window x:Class="PricklyApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PricklyApp.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Settings" Height="450" Width="400">
    <Grid Margin="25, 5, 25, 25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Label 
            Grid.Row="0"
            Content="Export to csv"/>
        <ListBox 
            x:Name="ProjectsListBox"
            Grid.Row="1"
            Height="100"
            Width="150"
            HorizontalAlignment="Left"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            SelectionMode="Multiple"
            />
        <Button
            Grid.Row="1"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="Export" />
        
        <Label
            Grid.Row="2"
            Margin="0, 10, 0, 0"
            Content="Import from csv"/>
        <TextBox
            x:Name="ImportTextBox"
            Grid.Row="3"
            Height="26"
            Width="150"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>
        <Button
            Grid.Row="3"
            Height="26"
            Width="75"
            Margin="30, 0, 0, 0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="Select File" />
        <Button
            Grid.Row="3"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="Import" />
        
        <Separator
            Grid.Row="4"
            Margin="0, 20, 0, 0"/>
        
        <Label
            Grid.Row="5"
            Margin="0, 10, 0, 0"
            Content="Set AFK Time"/>
        <TextBox
            x:Name="AFKTimeTextBox"
            Grid.Row="6"
            Height="26"
            Width="50"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>
        <ComboBox 
            Grid.Row="6"
            Height="26"
            Width="75"
            Margin="55, 0, 0, 0"
            HorizontalAlignment="Left"
            SelectedIndex="0">
            <ComboBoxItem x:Name="SecondsComboBoxItem">seconds</ComboBoxItem>
            <ComboBoxItem x:Name="MinutesComboBoxItem">minutes</ComboBoxItem>
            <ComboBoxItem x:Name="HoursComboBoxItem">hours</ComboBoxItem>
        </ComboBox>
        
        <Button
            Grid.Row="7"
            Height="26"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsDefault="True"
            Content="Save" />
        <Button 
            Grid.Row="7"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsCancel="True"
            Content="Cancel"
            />
    </Grid>
</Window>
