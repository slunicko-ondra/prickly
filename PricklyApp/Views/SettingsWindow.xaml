<Window x:Class="PricklyApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:PricklyApp.ViewModels"
        xmlns:local="clr-namespace:PricklyApp.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Closing="SettingsWindow_OnClosing"
        Title="Settings" Height="450" Width="425">
    <Window.DataContext>
        <viewModels:SettingsViewModel></viewModels:SettingsViewModel>
    </Window.DataContext>
    <Grid Margin="25, 5, 25, 25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Label 
            Grid.Row="0"
            Content="Export to csv"/>
        <ListBox 
            x:Name="ProjectsListBox"
            Grid.Row="1"
            Height="100"
            Width="228"
            HorizontalAlignment="Left"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            SelectionMode="Extended"
            ItemsSource="{Binding ProjectNames}"
            />
        <Button
            x:Name="ExportButton"
            Grid.Row="1"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="Export"
            Click="ExportButton_OnClick"/>
        
        <Label
            Grid.Row="2"
            Margin="0, 10, 0, 0"
            Content="Import LiteDB file (.db)"/>
        <TextBox
            x:Name="ImportTextBox"
            Grid.Row="3"
            Height="26"
            Width="150"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            VerticalContentAlignment="Center"/>
        <Button
            x:Name="SelectFileButton"
            Grid.Row="3"
            Height="26"
            Width="75"
            Margin="30, 0, 0, 0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="Select File"
            Click="SelectFileButton_OnClick"/>
        <Button
            x:Name="ImportButton"
            Grid.Row="3"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="Import"
            Click="ImportButton_OnClick"/>
        
        <Label
            Grid.Row="4"
            Margin="0, 20, 0, 0"
            Content="Delete all projects"/>
        <Button
            x:Name="DeleteButton"
            Grid.Row="4"
            Height="26"
            Width="75"
            Margin="125, 20, 0, 0"
            HorizontalAlignment="Left"
            Content="Delete"
            Click="DeleteButton_OnClick"/>
        
        <Separator
            Grid.Row="5"
            Margin="0, 20, 0, 0"/>
        
        <Label
            Grid.Row="6"
            Margin="0, 10, 0, 0"
            Content="Set AFK Time"/>
        <TextBox
            x:Name="AfkTimeTextBox"
            Grid.Row="7"
            Height="26"
            Width="50"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            VerticalContentAlignment="Center"
            PreviewTextInput="AfkTimeTextBox_OnPreviewTextInput"
            Text="{Binding AfkTime}"/>
        <ComboBox
            x:Name="TimeUnitComboBox"
            Grid.Row="7"
            Height="26"
            Width="75"
            Margin="55, 0, 0, 0"
            HorizontalAlignment="Left"
            ItemsSource="{Binding TimeUnits}"
            SelectionChanged="TimeUnitComboBox_OnSelectionChanged"/>
        <Button
            x:Name="SaveButton"
            Grid.Row="8"
            Height="26"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsDefault="True"
            Content="Save"
            Click="SaveButton_OnClick"/>
        <Button 
            Grid.Row="8"
            Height="26"
            Width="100"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsCancel="True"
            Content="Cancel"
            />
    </Grid>
</Window>
